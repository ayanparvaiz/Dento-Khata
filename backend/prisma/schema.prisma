// Dental Practice Management — MULTI-TENANT (SaaS) data model (PostgreSQL)
// Each clinic = a Tenant. Every tenant-scoped table carries `tenantId`.
// Isolation is enforced in code by a Prisma middleware that injects/filters tenantId
// from the request's verified JWT (see src/tenant/*). Never trust a tenantId from the body.
// Multi-value fields (allergies, pocket depths, exam grid) are stored as JSON strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// PLATFORM (not tenant-scoped) — the SaaS registry & billing
// ===========================================================================

// A clinic account. The unit of tenancy.
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // login code, e.g. "smile-dental" (used at login)
  name      String
  ownerName String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true) // super-admin can suspend without deleting
  signupIp  String? // captured at signup — helps spot spam/abuse (many clinics from one IP)
  // Meta ad attribution: browser/click ids captured at signup, replayed on the (offline) purchase.
  fbp       String?
  fbc       String?
  signupUa  String? // user agent at signup (improves CAPI match quality)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  subscription Subscription?
}

// Platform operators (you). Separate from tenant users — cross-tenant, no tenantId.
model SuperAdmin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// A landing-page visit (not tenant-scoped — visitors aren't logged in).
// The browser upserts this by `sid` while reading the page: it reports total time
// on the page and how far down it scrolled, so the super-admin can see how engaging
// the marketing page is (avg read time + scroll depth = how much people actually read).
model VisitSession {
  id          String   @id @default(cuid())
  sid         String   @unique // client-generated visit id (sessionStorage)
  path        String   @default("/")
  referrer    String? // where they came from
  utmSource   String? // ?utm_source= (e.g. "fb")
  utmCampaign String? // ?utm_campaign=
  ip          String?
  ua          String?
  device      String? // "mobile" | "desktop"
  durationMs  Int      @default(0) // total active time on the page (max reported)
  maxScroll   Int      @default(0) // furthest scroll depth, 0–100 %
  signedUp    Boolean  @default(false) // did this visit convert to a signup?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

// Platform-level error / failed-login log so the super-admin can see when a clinic hits
// a server error or can't log in. Written by a global exception filter; never tenant-scoped.
model ErrorLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  kind      String   @default("ERROR") // ERROR (5xx) | LOGIN_FAIL | FORBIDDEN
  status    Int? // HTTP status
  method    String?
  path      String?
  message   String?
  phone     String? // attempted login phone (for LOGIN_FAIL)
  tenantId  String?
  userId    String?
  ip        String?
  ua        String?

  @@index([createdAt])
}

// A successful login (platform-level, not tenant-scoped). Captured on every login so the
// super-admin can spot suspicious patterns: one IP into many clinics, or one clinic from
// many IPs (shared/leaked credentials or multi-account abuse).
model LoginLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  tenantId   String?
  userId     String?
  phone      String?
  clinicName String?
  ip         String?
  ua         String?

  @@index([createdAt])
  @@index([ip])
  @@index([tenantId])
}

// One subscription per tenant. Gateway-agnostic (Phase 1 = manual bKash).
model Subscription {
  id               String    @id @default(cuid())
  tenantId         String    @unique @default("")
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan             String    @default("STANDARD")
  status           String    @default("PENDING") // PENDING | ACTIVE | PAST_DUE | SUSPENDED
  currentPeriodEnd DateTime? // access allowed while now <= this (+grace)
  purchaseTrackedAt DateTime? // Meta Purchase event sent once, on first activated visit
  amount           Float     @default(990)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  payments SubscriptionPayment[]
}

// A payment/verification event: a manual bKash send, or a super-admin manual grant.
model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId       String @default("")
  amount         Float        @default(0)
  method         String       @default("BKASH") // BKASH | MANUAL_GRANT
  trxId          String? // bKash transaction id the tenant submitted
  senderMsisdn   String? // phone number the money came from
  status         String       @default("SUBMITTED") // SUBMITTED | VERIFIED | REJECTED
  periodDays     Int          @default(30) // days added on verification
  note           String?
  submittedAt    DateTime     @default(now())
  verifiedAt     DateTime?
  verifiedBy     String? // super-admin id

  @@index([tenantId])
  @@index([status])
}

// ===========================================================================
// Auth & users (tenant-scoped)
// ===========================================================================
model User {
  id           String   @id @default(cuid())
  tenantId     String @default("")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone        String   @unique // LOGIN identifier — globally unique across all clinics
  username     String? // optional display/login name
  passwordHash String
  fullName     String
  role         String   @default("ASSISTANT") // OWNER | ADMIN | ASSISTANT
  permissions  String? // JSON array of capability keys granted to an ASSISTANT (ADMIN/OWNER = all)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  appointments Appointment[]
  auditLogs    AuditLog[]

  @@index([tenantId])
}

// ===========================================================================
// Patient (tenant-scoped)
// ===========================================================================
model Patient {
  id             String    @id @default(cuid())
  tenantId       String @default("")
  code           String // human-readable id e.g. P-00123 (unique per tenant)
  fullName       String
  photoPath      String?
  dateOfBirth    DateTime?
  gender         String? // MALE | FEMALE | OTHER
  phone          String?
  email          String?
  address        String?
  bloodGroup     String? // A+, O-, etc.
  occupation     String?
  maritalStatus  String? // SINGLE | MARRIED | OTHER
  referralSource String? // how the patient found the clinic
  emergencyName  String?
  emergencyPhone String?
  guardianName   String? // for minors
  behaviourGrade String? // A+ | A | A- | F — how cooperative/interested the patient is in treatment
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  medicalHistory   MedicalHistory?
  appointments     Appointment[]
  toothRecords     ToothRecord[]
  perioRecords     PerioRecord[]
  treatmentPlans   TreatmentPlan[]
  treatmentRecords TreatmentRecord[]
  clinicalNotes    ClinicalNote[]
  prescriptions    Prescription[]
  invoices         Invoice[]
  payments         Payment[]
  files            PatientFile[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([fullName])
  @@index([phone])
}

model MedicalHistory {
  id                String   @id @default(cuid())
  tenantId          String @default("")
  patientId         String   @unique
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergies         String? // JSON array string
  medications       String?
  conditions        String? // diabetes, hypertension, cardiac, bleeding...
  habits            String? // smoking, tobacco/gutka, betel nut, alcohol
  pastDentalHistory String?
  isPregnant        Boolean  @default(false)
  premedRequired    Boolean  @default(false)
  notes             String?
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
}

// ===========================================================================
// Appointment (tenant-scoped)
// ===========================================================================
model Appointment {
  id        String   @id @default(cuid())
  tenantId  String @default("")
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId String?
  dentist   User?    @relation(fields: [dentistId], references: [id])
  chair     String?
  startTime DateTime
  endTime   DateTime
  status    String   @default("BOOKED") // BOOKED CONFIRMED ARRIVED IN_CHAIR COMPLETED NO_SHOW CANCELLED
  reason    String?
  notes     String?
  createdAt DateTime @default(now())

  files    PatientFile[]
  payments Payment[]

  @@index([tenantId])
  @@index([startTime])
  @@index([patientId])
}

// ===========================================================================
// Dental charting (tenant-scoped)
// ===========================================================================
model ToothRecord {
  id          String   @id @default(cuid())
  tenantId    String @default("")
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNumber String // FDI notation e.g. "11", "48", primary "55"
  surface     String? // M | D | O | B | L (null = whole tooth)
  condition   String // CARIES MISSING FILLED CROWN BRIDGE IMPLANT RCT EXTRACTED HEALTHY ...
  status      String   @default("EXISTING") // EXISTING | PLANNED | COMPLETED
  note        String?
  recordedAt  DateTime @default(now())
  recordedBy  String?

  @@index([tenantId])
  @@index([patientId])
}

model PerioRecord {
  id          String   @id @default(cuid())
  tenantId    String @default("")
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNumber String
  pocketDepth String? // JSON: 6 points {mb,b,db,ml,l,dl}
  bleeding    String? // JSON: which points bled
  recession   String?
  mobility    Int? // 0-3
  furcation   Int? // 0-3
  recordedAt  DateTime @default(now())

  @@index([tenantId])
  @@index([patientId])
}

// ===========================================================================
// Treatment & procedures (tenant-scoped)
// ===========================================================================
model Procedure {
  id         String  @id @default(cuid())
  tenantId   String @default("")
  code       String // ADA CDT or custom (unique per tenant)
  name       String
  category   String?
  defaultFee Float   @default(0)
  isActive   Boolean @default(true)

  treatmentItems TreatmentItem[]
  invoiceItems   InvoiceItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model TreatmentPlan {
  id        String   @id @default(cuid())
  tenantId  String @default("")
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String?
  status    String   @default("PROPOSED") // PROPOSED | ACCEPTED | IN_PROGRESS | COMPLETED
  createdAt DateTime @default(now())

  items         TreatmentItem[]
  records       TreatmentRecord[]
  prescriptions Prescription[]

  @@index([tenantId])
}

// Per-visit treatment log: a dated one-line note of what was done (e.g. RCT day 2).
model TreatmentRecord {
  id        String         @id @default(cuid())
  tenantId  String @default("")
  patientId String
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  planId    String?
  plan      TreatmentPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  content   String
  amount    Float          @default(0) // charge the doctor sets for this visit (patient may pay less/more)
  visitDate DateTime       @default(now())
  authorId  String?
  createdAt DateTime       @default(now())

  payments Payment[]

  @@index([tenantId])
  @@index([patientId])
}

model TreatmentItem {
  id          String        @id @default(cuid())
  tenantId    String @default("")
  planId      String
  plan        TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  procedureId String
  procedure   Procedure     @relation(fields: [procedureId], references: [id])
  toothNumber String?
  priority    Int           @default(0)
  status      String        @default("PLANNED") // PLANNED | COMPLETED
  fee         Float
  completedAt DateTime?
  billed      Boolean       @default(false) // charged to an invoice yet?

  @@index([tenantId])
}

model ClinicalNote {
  id        String   @id @default(cuid())
  tenantId  String @default("")
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  content   String
  authorId  String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([patientId])
}

// ===========================================================================
// Prescription & drugs
// Drug catalog is GLOBAL/shared across all tenants (not tenant-scoped).
// ===========================================================================
model Drug {
  id       String  @id @default(cuid())
  name     String // brand
  generic  String?
  category String? // antibiotic, analgesic, antiseptic...
  form     String? // tablet, capsule, syrup, gel
  strength String? // 500mg
  isActive Boolean @default(true)

  prescriptionItems PrescriptionItem[]

  @@index([name])
}

model Prescription {
  id             String         @id @default(cuid())
  tenantId       String @default("")
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dentistId      String?
  // Clinical fields (ZilSoft-style)
  diagnosis      String? // Disease / Condition / Dx
  chiefComplaint String? // C/C
  onExam         String? // O/E
  examGrid       String? // JSON: { UR, UL, LR, LL } tooth findings
  investigation  String? // Ix / Advice
  notes          String? // internal — not printed
  advice         String? // উপদেশ (printed)
  followUp       String? // e.g. "1 month", "7 days"
  planId         String? // optional link to a treatment plan (Rx Plan)
  plan           TreatmentPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  // Doctor's quick figures (printed on Rx; not the billing ledger)
  totalBill      Float?
  discount       Float?
  paidToday      Float?
  visitsNeeded   Int?
  createdAt      DateTime       @default(now())

  items PrescriptionItem[]

  @@index([tenantId])
  @@index([patientId])
}

model PrescriptionItem {
  id             String       @id @default(cuid())
  tenantId       String @default("")
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  drugId         String?
  drug           Drug?        @relation(fields: [drugId], references: [id])
  drugName       String // snapshot (brand) in case drug edited later
  generic        String? // snapshot of generic name
  dosage         String // e.g. "1+0+1"
  frequency      String?
  duration       String? // "7 days"
  route          String? // oral, topical
  timing         String? // খাবার আগে / খাবার পর / ভরা পেটে
  instruction    String? // after meal...

  @@index([tenantId])
}

// ===========================================================================
// Billing (tenant-scoped)
// ===========================================================================
model Invoice {
  id        String   @id @default(cuid())
  tenantId  String @default("")
  number    String // unique per tenant
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subtotal  Float    @default(0)
  discount  Float    @default(0)
  total     Float    @default(0)
  status    String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  createdAt DateTime @default(now())

  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([patientId])
}

model InvoiceItem {
  id          String     @id @default(cuid())
  tenantId    String @default("")
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  procedureId String?
  procedure   Procedure? @relation(fields: [procedureId], references: [id])
  description String
  toothNumber String?
  qty         Int        @default(1)
  unitPrice   Float
  amount      Float

  @@index([tenantId])
}

model Payment {
  id                String           @id @default(cuid())
  tenantId          String @default("")
  // Payments are patient-level installments (collected a bit each visit).
  patientId         String?
  patient           Patient?         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId     String? // which visit it was collected at
  appointment       Appointment?     @relation(fields: [appointmentId], references: [id])
  treatmentRecordId String? // which treatment-record visit this payment is for (per-visit invoice)
  treatmentRecord   TreatmentRecord? @relation(fields: [treatmentRecordId], references: [id], onDelete: SetNull)
  invoiceId         String? // legacy / optional invoice link
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount            Float
  method            String // CASH | CARD | BKASH | NAGAD | OTHER
  paidAt            DateTime         @default(now())
  receivedBy        String?
  note              String?

  @@index([tenantId])
  @@index([patientId])
}

// ===========================================================================
// Imaging & documents (tenant-scoped)
// ===========================================================================
model PatientFile {
  id            String       @id @default(cuid())
  tenantId      String @default("")
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  filePath      String // stored path on server PC disk
  fileName      String // original name
  mimeType      String // image/jpeg, image/png, application/pdf
  fileType      String       @default("IMAGE") // IMAGE | DOCUMENT
  category      String? // INTRAORAL | OPG | PERIAPICAL | BITEWING | PHOTO | LAB_REPORT | CONSENT | OTHER
  toothNumber   String?
  caption       String?
  takenAt       DateTime?
  uploadedAt    DateTime     @default(now())
  uploadedBy    String?

  @@index([tenantId])
  @@index([patientId])
}

// ===========================================================================
// System
// ===========================================================================
// One settings row PER TENANT (was a global singleton).
model ClinicSettings {
  id             String  @id @default(cuid())
  tenantId       String  @unique @default("")
  name           String  @default("My Dental Clinic")
  address        String?
  phone          String?
  logoPath       String?
  letterhead     String?
  // Shared letterhead template for prescription + invoice print
  headerTitle    String? // big title (doctor/clinic name)
  headerSubtitle String? // designation / qualifications
  headerExtra    String? // extra header line
  footerLeft     String? // multi-line (clinic name, address)
  footerRight    String? // multi-line (phone, visit hours)
  themeColor     String? // print theme color (hex) for prescription + invoice
  toothNotation  String  @default("PALMER") // FDI | UNIVERSAL | PALMER (Palmer most used in BD)
  currency       String  @default("BDT")
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String?
  userId   String?
  user     User?    @relation(fields: [userId], references: [id])
  action   String // CREATE | UPDATE | DELETE
  entity   String // table name
  entityId String?
  detail   String? // JSON diff
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}
