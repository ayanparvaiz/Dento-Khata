# dependencies
node_modules/
**/node_modules/

# builds
dist/
**/dist/

# env / secrets
.env
**/.env
*.local

# SQLite database (data, not source)
*.db
*.db-journal
*.db-wal
*.db-shm

# uploaded files (x-rays/photos/docs)
backend/uploads/*
!backend/uploads/.gitkeep

# runtime persistent data folder (db + uploads + backups) — never commit
/data/

# e2e artifacts
e2e/shots/
e2e/test-results/

# npm lockfiles — this repo installs with pnpm locally and plain `npm install` in CI;
# a stray package-lock.json (from a one-off `npm install`) would silently change what CI
# resolves. `npm run release` does `git add -A`, so keep it out of reach.
package-lock.json

# agent/editor notes — not part of the product
CLAUDE.md

# misc
.DS_Store
*.log
