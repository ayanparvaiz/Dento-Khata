{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dento Khata",
  "version": "0.1.1",
  "identifier": "com.dentokhata.app",
  "build": {
    "frontendDist": "../splash",
    "beforeBuildCommand": "npm run prepare-backend"
  },
  "app": {
    "windows": [
      {
        "title": "Dento Khata",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://dento.devcenter.dev/update/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1REYzRkUzRjAxRUFBMjAKUldRZ3FoN3c0ei9mVldFSkJmKzYrMXVUU3VIbjRVcEsrVkp6MkJaMnNzNEZ4eFI2YzZtRkZEeGcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "resources"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
