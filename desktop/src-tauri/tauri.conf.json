{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dento Khata",
  "version": "0.1.0",
  "identifier": "com.dentokhata.app",
  "build": {
    "frontendDist": "../splash",
    "beforeBuildCommand": "npm run prepare-backend"
  },
  "app": {
    "windows": [
      {
        "title": "Dento Khata",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
